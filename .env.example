# 1. APIFY (Primary Job Search)
# Free token from https://apify.com (leave blank for free open APIs fallback)
APIFY_API_TOKEN=

# 2. RESUME
# Source of truth for skills & matching (.pdf, .docx, .txt, .md)
RESUME_PATH=resume/sample_resume.md

# 3. AI / LLM (Optional - gemini, groq, openai, or blank for keyword engine)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# 4. EMAIL (Brevo Free SMTP or Gmail)
EMAIL_ENABLED=true
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@smtp-brevo.com
SMTP_PASSWORD=your_brevo_smtp_master_key
EMAIL_SENDER=your_verified_email@gmail.com
EMAIL_RECIPIENT=your_email@gmail.com

# 5. WHATSAPP (green_api, pywhatkit, callmebot, twilio)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=green_api
CALLMEBOT_PHONE=+919876543210
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
CALLMEBOT_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+919876543210

# 6. TELEGRAM (Free mobile alerts via @BotFather)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 7. NTFY.SH (Free anonymous push notifications via ntfy mobile app)
NTFY_ENABLED=false
NTFY_TOPIC=my_daily_job_alerts_topic

# 8. DISCORD (Free webhook alerts)
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# 9. GOOGLE DRIVE (Local Drive folder sync or Cloud API)
GDRIVE_ENABLED=true
GDRIVE_LOCAL_PATH=
GDRIVE_FOLDER_ID=https://drive.google.com/drive/folders/1_iBWaeS4WkDJdIjpclBEZaulgPbV5M2F?usp=sharing
GDRIVE_SERVICE_ACCOUNT_JSON=config/gdrive_service_account.json

# 10. DATABASE (Blank for local SQLite jobs_history.db, or PostgreSQL connection string)
DATABASE_URL=

# 11. PIPELINE SETTINGS
DAILY_RUN_TIME=08:00
TARGET_DAILY_JOBS=25
MIN_MATCH_SCORE=70
