# ==========================================
# DAILY AI JOB HUNTING AGENT - CONFIGURATION
# ==========================================

# 1. APIFY CONFIGURATION (Primary Job Search Engine)
# Sign up at https://apify.com to get your free token (5$ free monthly credit = thousands of jobs)
APIFY_API_TOKEN=your_apify_api_token_here

# 2. RESUME FILE PATH
# Put your resume in the resume/ folder or specify an absolute path (.pdf, .docx, .txt, .md)
RESUME_PATH=resume/sample_resume.md

# 3. OPTIONAL LLM API (For Enhanced Semantic Resume Matching & Scoring)
# Options: gemini (Free tier), groq (Free tier), openai, or leave blank to use built-in smart TF-IDF/keyword matcher
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=
OPENAI_API_KEY=

# 4. EMAIL NOTIFICATION (SMTP - Gmail App Password / Outlook / Custom SMTP)
EMAIL_ENABLED=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
EMAIL_RECIPIENT=your_email@gmail.com

# 5. WHATSAPP NOTIFICATION
# Choose provider: callmebot (100% Free instant WhatsApp messages) or twilio or disabled
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=callmebot
# For CallMeBot (Get API key free in 10 seconds: send "I allow callmebot to send me messages" to +34 941 01 99 62 on WhatsApp)
CALLMEBOT_PHONE=+919876543210
CALLMEBOT_API_KEY=your_callmebot_api_key

# For Twilio (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+919876543210

# 6. GOOGLE DRIVE SYNC (Optional auto-upload of Excel reports)
GDRIVE_ENABLED=false
GDRIVE_FOLDER_ID=your_google_drive_folder_id_here
GDRIVE_SERVICE_ACCOUNT_JSON=config/gdrive_service_account.json

# 7. AGENT EXECUTION
DAILY_RUN_TIME=08:00
TARGET_DAILY_JOBS=25
MIN_MATCH_SCORE=70
